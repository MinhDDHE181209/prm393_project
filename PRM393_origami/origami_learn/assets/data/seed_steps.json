  "model_boat": [
    {
      "stepIndex": 1,
      "imageUrl": "assets/images/boat/step_1.png",
      "instructionVi": "Gấp giấy hình chữ nhật theo chiều dọc rồi mở ra, xoay ngang và gấp đôi theo chiều ngang, mở ra tiếp — tạo 2 đường [[中心線|Chūshinsen|Đường trung tâm]] vuông góc làm mốc cho các bước sau.",
      "vocabList": [
        {
          "kanji": "中心線",
          "romaji": "Chūshinsen",
          "meaningVi": "Đường trung tâm"
        }
      ]
    },
    {
      "stepIndex": 2,
      "imageUrl": "assets/images/boat/step_2.png",
      "instructionVi": "Lật giấy sao cho mép mở hướng về phía bạn, gấp 2 góc trên vào đường trung tâm, chừa lại một khoảng trống nhỏ ở mép dưới để tạo 2 hình [[三角形|Sankakukei|Tam giác]].",
      "vocabList": [
        {
          "kanji": "三角形",
          "romaji": "Sankakukei",
          "meaningVi": "Hình tam giác"
        }
      ]
    },
    {
      "stepIndex": 3,
      "imageUrl": "assets/images/boat/step_3.png",
      "instructionVi": "Gấp mép dưới của mặt trước lên, che kín đáy 2 tam giác vừa tạo, miết chặt nếp gấp.",
      "vocabList": []
    },
    {
      "stepIndex": 4,
      "imageUrl": "assets/images/boat/step_4.png",
      "instructionVi": "Lật giấy lại, gấp mép dưới của mặt sau lên tương tự để hoàn thành [[帽子折り|Bōshi ori|Hình gấp kiểu mũ]].",
      "vocabList": [
        {
          "kanji": "帽子折り",
          "romaji": "Bōshi ori",
          "meaningVi": "Hình gấp kiểu mũ"
        }
      ]
    },
    {
      "stepIndex": 5,
      "imageUrl": "assets/images/boat/step_5.png",
      "instructionVi": "Gấp 2 góc dưới còn thừa ra vào trong, trùm qua cạnh tam giác ở cả 2 mặt để giữ hình mũ chắc chắn.",
      "vocabList": []
    },
    {
      "stepIndex": 6,
      "imageUrl": "assets/images/boat/step_6.png",
      "instructionVi": "Xoay hình mũ 45 độ, dùng tay mở phần đáy và kéo nhẹ 2 bên ra xa nhau đến khi bật thành hình [[菱形|Hishigata|Hình thoi]].",
      "vocabList": [
        {
          "kanji": "菱形",
          "romaji": "Hishigata",
          "meaningVi": "Hình thoi"
        }
      ]
    },
    {
      "stepIndex": 7,
      "imageUrl": "assets/images/boat/step_7.png",
      "instructionVi": "Gấp đỉnh dưới của hình thoi lên trùng với đỉnh trên, thực hiện tương tự ở cả mặt trước và mặt sau.",
      "vocabList": []
    },
    {
      "stepIndex": 8,
      "imageUrl": "assets/images/boat/step_8.png",
      "instructionVi": "Lặp lại động tác mở đáy và kéo bật như bước 6 một lần nữa để tạo thành hình vuông nhỏ hơn.",
      "vocabList": []
    },
    {
      "stepIndex": 9,
      "imageUrl": "assets/images/boat/step_9.png",
      "instructionVi": "Kéo nhẹ 2 bên hình thoi ra như cánh hoa để lộ khoang thuyền, miết đáy cho thuyền đứng vững — chiếc [[船|Fune|Thuyền]] đã hoàn thành! Phần tam giác dựng thẳng ở giữa là [[帆柱|Hobashira|Cột buồm]].",
      "vocabList": [
        {
          "kanji": "船",
          "romaji": "Fune",
          "meaningVi": "Thuyền"
        },
        {
          "kanji": "帆柱",
          "romaji": "Hobashira",
          "meaningVi": "Cột buồm"
        }
      ]
    }
